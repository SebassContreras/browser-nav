index 0000000..0594154
--- /dev/null
+++ b/src/screens/screen-discover.ts
@@ -0,0 +1,210 @@
+// History-assisted route discovery engine (spec 011 D2, D3).
+// Inspects visited history entries from places.sqlite, generalizes dynamic segments,
+// groups visits, drops routes already covered, and enriches unmapped[] in the screen map.
+import type { StoredHistoryEntry } from "../browser/history-reader.js";
+import type { ScreenMap } from "./screen-map.js";
+import { assertValidRoutePattern, matchRoute } from "./screen-match.js";
+
+export interface DiscoveredRouteCandidate {
+  route: string;
+  visitCount: number;
+  lastVisitDate: number; // PRTime (microseconds)
+  lastTitle: string;
+}
+
+const UUID_REGEX = /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
+const HEX_OPAQUE_REGEX = /^(?=.*[0-9])(?=.*[a-zA-Z])[0-9a-zA-Z_-]{16,}$/;
+
+/**
+ * Generalises a single path segment if it looks like an identifier or token.
+ */
+function generaliseSegment(segment: string): { isParam: boolean; type?: "id" | "uuid" | "token" } {
+  if (/^\d+$/.test(segment)) {
+    return { isParam: true, type: "id" };
+  }
+  if (UUID_REGEX.test(segment)) {
+    return { isParam: true, type: "uuid" };
+  }
+  if (HEX_OPAQUE_REGEX.test(segment)) {
+    return { isParam: true, type: "token" };
+  }
+  return { isParam: false };
+}
+
+/**
+ * Generalises a pathname into a valid route pattern:
+ * e.g. "/users/123/posts/abc-123-uuid" -> "/users/:id/posts/:uuid"
+ * Repeated param names get numerical suffixes (:id, :id2) to satisfy assertValidRoutePattern.
+ */
+export function generalisePathname(pathname: string): string {
+  const normalised = pathname.startsWith("/") ? pathname : `/${pathname}`;
+  const segments = normalised.split("/").filter((s) => s.length > 0);
+  if (segments.length === 0) {
+    return "/";
+  }
+
+  const usedParamCounts: Record<string, number> = {};
+  const generalisedSegments = segments.map((seg) => {
+    let decoded = seg;
+    try {
+      decoded = decodeURIComponent(seg);
+    } catch {
+      decoded = seg;
+    }
+
+    const { isParam, type } = generaliseSegment(decoded);
+    if (!isParam || !type) {
+      return seg;
+    }
+
+    const count = (usedParamCounts[type] ?? 0) + 1;
+    usedParamCounts[type] = count;
+    const paramName = count === 1 ? `:${type}` : `:${type}${count}`;
+    return paramName;
+  });
+
+  const pattern = `/${generalisedSegments.join("/")}`;
+  // Ensure the generated pattern passes valid syntax
+  try {
+    assertValidRoutePattern(pattern);
+    return pattern;
+  } catch {
+    // Fallback to literal if invalid
+    return normalised;
+  }
+}
+
+/**
+ * Pure function to discover candidate routes from raw history entries and an existing ScreenMap.
+ */
+export function discoverRoutes(
+  entries: readonly StoredHistoryEntry[],
+  map: ScreenMap,
+  options: { limit?: number } = {},
+): DiscoveredRouteCandidate[] {
+  const limit = options.limit ?? 50;
+  const groups = new Map<
+    string,
+    {
+      visitCount: number;
+      lastVisitDate: number;
+      lastTitle: string;
+    }
+  >();
+
+  for (const entry of entries) {
+    let pathname: string;
+    try {
+      const parsed = new URL(entry.url);
+      pathname = parsed.pathname;
+    } catch {
+      continue;
+    }
+
+    // Normalise: drop trailing slash unless root
+    if (pathname.length > 1 && pathname.endsWith("/")) {
+      pathname = pathname.slice(0, -1);
+    }
+
+    const route = generalisePathname(pathname);
+
+    // Drop routes already covered by any screen in the map
+    const coveredByScreen = map.screens.some((screen) => {
+      try {
+        return matchRoute(screen.route, pathname) !== null;
+      } catch {
+        return false;
+      }
+    });
+    if (coveredByScreen) {
+      continue;
+    }
+
+    // Drop routes already in unmapped[]
+    const coveredByUnmapped = (map.unmapped ?? []).some((u) => {
+      if (!u.route) return false;
+      try {
+        return matchRoute(u.route, pathname) !== null || u.route === route;
+      } catch {
+        return u.route === pathname || u.route === route;
+      }
+    });
+    if (coveredByUnmapped) {
+      continue;
+    }
+
+    const existing = groups.get(route);
+    const title = entry.title?.trim() || "";
+    if (!existing) {
+      groups.set(route, {
+        visitCount: entry.visitCount,
+        lastVisitDate: entry.lastVisitDate,
+        lastTitle: title,
+      });
+    } else {
+      existing.visitCount += entry.visitCount;
+      if (entry.lastVisitDate >= existing.lastVisitDate) {
+        existing.lastVisitDate = entry.lastVisitDate;
+        if (title) {
+          existing.lastTitle = title;
+        }
+      }
+    }
+  }
+
+  const candidates: DiscoveredRouteCandidate[] = Array.from(groups.entries()).map(
+    ([route, data]) => ({
+      route,
+      visitCount: data.visitCount,
+      lastVisitDate: data.lastVisitDate,
+      lastTitle: data.lastTitle,
+    }),
+  );
+
+  // Sort by visits desc, then lastVisitDate desc
+  candidates.sort((a, b) => {
+    if (b.visitCount !== a.visitCount) {
+      return b.visitCount - a.visitCount;
+    }
+    return b.lastVisitDate - a.lastVisitDate;
+  });
+
+  return candidates.slice(0, limit);
+}
+
+/**
+ * Appends discovered candidates to the map's unmapped[] array (spec 011 D3).
+ * Returns a new ScreenMap instance without mutating the input.
+ */
+export function applyDiscovery(
+  map: ScreenMap,
+  candidates: readonly DiscoveredRouteCandidate[],
+): ScreenMap {
+  if (candidates.length === 0) {
+    return map;
+  }
+
+  const existingUnmapped = map.unmapped ? [...map.unmapped] : [];
+  const existingRoutes = new Set(existingUnmapped.map((u) => u.route).filter(Boolean));
+
+  for (const c of candidates) {
+    if (!existingRoutes.has(c.route)) {
+      const dateStr =
+        c.lastVisitDate > 0
+          ? new Date(Math.floor(c.lastVisitDate / 1000)).toISOString()
+          : "unknown";
+      const titleSnippet = c.lastTitle ? `, title "${c.lastTitle}"` : "";
+      existingUnmapped.push({
+        route: c.route,
+        reason: "history",
+        note: `${c.visitCount} visits, last ${dateStr}${titleSnippet}`,
+      });
+      existingRoutes.add(c.route);
+    }
+  }
+
+  return {
+    ...map,
+    unmapped: existingUnmapped,
+  };
+}
