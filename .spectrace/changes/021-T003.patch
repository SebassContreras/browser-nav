@@ -0,0 +1,175 @@
+import { copyFileSync, existsSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+
+export interface ExtractedCookie {
+  name: string;
+  value: string;
+  domain: string;
+  path: string;
+  expiry?: number;
+  httpOnly: boolean;
+  secure: boolean;
+  sameSite: "strict" | "lax" | "none";
+}
+
+export interface CookieExtractorOptions {
+  profileDir: string;
+  targetDomains: string[];
+}
+
+export interface CookieExtractor {
+  extractCookies(options: CookieExtractorOptions): Promise<ExtractedCookie[]>;
+}
+
+/**
+ * Normalizes host/domain filter strings into match patterns.
+ * e.g. "https://www.linkedin.com" -> ["linkedin.com", ".linkedin.com"]
+ */
+export function extractRootDomains(input: string): string[] {
+  let hostname = input.trim().toLowerCase();
+  try {
+    if (hostname.includes("://")) {
+      hostname = new URL(hostname).hostname;
+    }
+  } catch {
+    // Keep as-is if unparseable
+  }
+
+  // Strip leading dot or port
+  hostname = hostname.replace(/:\d+$/, "").replace(/^\./, "");
+  if (!hostname) {
+    return [];
+  }
+
+  const parts = hostname.split(".");
+  const domains: Set<string> = new Set();
+  domains.add(hostname);
+  domains.add(`.${hostname}`);
+
+  // If subdomains present (e.g. "notebook.google.com" -> add "google.com" and ".google.com")
+  if (parts.length > 2) {
+    const root = parts.slice(-2).join(".");
+    domains.add(root);
+    domains.add(`.${root}`);
+  }
+
+  return Array.from(domains);
+}
+
+/**
+ * Maps SQLite SameSite integer to standard W3C BiDi sameSite string.
+ * 0 = None, 1 = Lax, 2 = Strict
+ */
+function mapSameSite(val: number | null | undefined): "strict" | "lax" | "none" {
+  if (val === 2) return "strict";
+  if (val === 1) return "lax";
+  return "none";
+}
+
+/**
+ * FirefoxCookieExtractor reads unencrypted cookies directly from Firefox's `cookies.sqlite`.
+ * Uses temporary file cloning to guarantee lock-free reads while Firefox is running.
+ */
+export class FirefoxCookieExtractor implements CookieExtractor {
+  async extractCookies(options: CookieExtractorOptions): Promise<ExtractedCookie[]> {
+    const dbPath = join(options.profileDir, "cookies.sqlite");
+    if (!existsSync(dbPath)) {
+      return [];
+    }
+
+    // Prepare temporary copy to prevent SQLITE_BUSY / lock contention with running browser
+    const tempSuffix = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
+    const tempDb = join(tmpdir(), `pwa-nav-cookies-${tempSuffix}.sqlite`);
+    const tempWal = join(tmpdir(), `pwa-nav-cookies-${tempSuffix}.sqlite-wal`);
+
+    try {
+      copyFileSync(dbPath, tempDb);
+
+      const walSource = `${dbPath}-wal`;
+      if (existsSync(walSource)) {
+        try {
+          copyFileSync(walSource, tempWal);
+        } catch {
+          // Non-blocking if WAL is locked or unavailable
+        }
+      }
+
+      // Compute matching domains
+      const allDomains = new Set<string>();
+      for (const d of options.targetDomains) {
+        for (const root of extractRootDomains(d)) {
+          allDomains.add(root);
+        }
+      }
+
+      if (allDomains.size === 0) {
+        return [];
+      }
+
+      const db = new DatabaseSync(tempDb, { readOnly: true });
+      try {
+        const placeholders = Array.from(allDomains).map(() => "?").join(", ");
+        const query = `
+          SELECT name, value, host, path, expiry, isSecure, isHttpOnly, sameSite
+          FROM moz_cookies
+          WHERE host IN (${placeholders})
+             OR host LIKE '%.google.com' AND ? LIKE '%google.com%'
+             OR host LIKE '%.linkedin.com' AND ? LIKE '%linkedin.com%'
+        `;
+
+        const args = [...Array.from(allDomains), ...options.targetDomains.slice(0, 2)];
+        // Pad args if less than expected placeholders
+        while (args.length < allDomains.size + 2) {
+          args.push("");
+        }
+
+        const stmt = db.prepare(query);
+        const rows = stmt.all(...args) as Array<{
+          name: string;
+          value: string;
+          host: string;
+          path: string;
+          expiry?: number;
+          isSecure?: number;
+          isHttpOnly?: number;
+          sameSite?: number;
+        }>;
+
+        const results: ExtractedCookie[] = [];
+        const nowSec = Math.floor(Date.now() / 1000);
+
+        for (const row of rows) {
+          // Filter out expired cookies if expiry is present and in the past
+          if (row.expiry && row.expiry > 0 && row.expiry < nowSec) {
+            continue;
+          }
+
+          results.push({
+            name: row.name,
+            value: row.value,
+            domain: row.host,
+            path: row.path || "/",
+            expiry: row.expiry && row.expiry > 0 ? row.expiry : undefined,
+            secure: Boolean(row.isSecure),
+            httpOnly: Boolean(row.isHttpOnly),
+            sameSite: mapSameSite(row.sameSite),
+          });
+        }
+
+        return results;
+      } finally {
+        db.close();
+      }
+    } finally {
+      // Clean up temporary files
+      try {
+        if (existsSync(tempDb)) rmSync(tempDb, { force: true });
+        if (existsSync(tempWal)) rmSync(tempWal, { force: true });
+      } catch {
+        // Ephemeral cleanup failure is non-fatal
+      }
+    }
+  }
+}
