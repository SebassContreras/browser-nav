+test("spec 028 R1 & R2: MCP manifest declares canonical browser_* and screen_learn names while transparently routing legacy pwa_* calls", async () => {
+  // Given the pure alias resolver
+  assert.equal(resolveToolName("pwa_open"), "browser_open");
+  assert.equal(resolveToolName("pwa_learn"), "screen_learn");
+  assert.equal(resolveToolName("browser_open"), "browser_open");
+  assert.equal(resolveToolName("screen_learn"), "screen_learn");
+  assert.equal(Object.keys(LEGACY_TOOL_ALIASES).length, 16);
+
+  // Given a connected MCP client-server session
+  await withMcp({ armed: false }, async ({ client, agentDir }) => {
+    await allow(agentDir);
+
+    // When listing tools in the MCP manifest (R1)
+    const { tools } = await client.listTools();
+    const manifestNames = tools.map((t) => t.name).sort();
+
+    // Then the manifest declares all 15 canonical browser_* tools and screen_learn, and zero legacy pwa_* names
+    assert.deepEqual(manifestNames, [
+      "browser_act",
+      "browser_auth",
+      "browser_click",
+      "browser_config",
+      "browser_discover",
+      "browser_download",
+      "browser_extract",
+      "browser_fill",
+      "browser_find",
+      "browser_install_runtime",
+      "browser_open",
+      "browser_screenshot",
+      "browser_snapshot",
+      "browser_upload",
+      "browser_wait",
+      "screen_learn",
+    ]);
+
+    // When calling canonical browser_* and screen_learn tools (R1)
+    const canonicalOpen = await call(client, "browser_open", { url: `${ORIGIN}/login` });
+    assert.equal(canonicalOpen.isError, false, canonicalOpen.text);
+
+    const canonicalClick = await call(client, "browser_click", { target: "@show-password" });
+    assert.equal(canonicalClick.isError, false, canonicalClick.text);
+
+    const canonicalSnap = await call(client, "browser_snapshot", {});
+    assert.equal(canonicalSnap.isError, false, canonicalSnap.text);
+    const snapId = canonicalSnap.structured["snapshotId"] as string;
+
+    const canonicalFill = await call(client, "browser_fill", { snapshotId: snapId, ref: "e1", text: "user@example.com" });
+    assert.equal(canonicalFill.isError, false, canonicalFill.text);
+
+    const canonicalFind = await call(client, "browser_find", { query: "Sign in" });
+    assert.equal(canonicalFind.isError, false, canonicalFind.text);
+
+    const canonicalLearn = await call(client, "screen_learn", { locale: "en", appId: "demo-app" });
+    assert.equal(canonicalLearn.isError, false, canonicalLearn.text);
+
+    // When calling legacy pwa_* aliases (R2)
+    const legacyOpen = await call(client, "pwa_open", { url: `${ORIGIN}/login` });
+    assert.equal(legacyOpen.isError, false, legacyOpen.text);
+
+    const legacyClick = await call(client, "pwa_click", { target: "@show-password" });
+    assert.equal(legacyClick.isError, false, legacyClick.text);
+
+    const legacySnap = await call(client, "pwa_snapshot", {});
+    assert.equal(legacySnap.isError, false, legacySnap.text);
+    const legacySnapId = legacySnap.structured["snapshotId"] as string;
+
+    const legacyFill = await call(client, "pwa_fill", { snapshotId: legacySnapId, ref: "e1", text: "user@example.com" });
+    assert.equal(legacyFill.isError, false, legacyFill.text);
+
+    const legacyFind = await call(client, "pwa_find", { query: "Sign in" });
+    assert.equal(legacyFind.isError, false, legacyFind.text);
+
+    const legacyLearn = await call(client, "pwa_learn", { locale: "en", appId: "demo-app" });
+    assert.equal(legacyLearn.isError, false, legacyLearn.text);
+  });
+});
