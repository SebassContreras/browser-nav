--- /dev/null
+++ b/src/screens/screen-filtering.ts
@@ -0,0 +1,226 @@
+import type { RawElement } from "../browser/collector.js";
+
+// Roles outside these three groups (heading, tab panels, menuitemcheckbox, ...) are ignored.
+export const FIELD_ROLES: ReadonlySet<string> = new Set([
+  "textbox", "searchbox", "spinbutton", "combobox", "listbox", "slider", "checkbox", "radio", "switch",
+]);
+export const ACTION_ROLES: ReadonlySet<string> = new Set(["button", "menuitem", "tab", "option"]);
+export const DYNAMIC_CONTAINER_ROLES: ReadonlySet<string> = new Set(["feed", "log", "article"]);
+
+/** Fold text to lowercase ASCII without diacritics, trimmed. */
+export function foldText(text: string): string {
+  return text.normalize("NFD").replace(/\p{M}+/gu, "").toLowerCase().trim();
+}
+
+const REACTION_EMOJI_PATTERN = /[\p{Extended_Pictographic}\uFE0F]/u;
+const QUICK_REACTION_PHRASES: ReadonlySet<string> = new Set([
+  "felicidades", "me alegro mucho por ti", "enhorabuena", "congrats", "congratulations",
+  "kudos", "bravo", "gracias", "thank you", "thanks", "de acuerdo", "agree",
+  "me gusta", "like", "interesante", "interesting", "apoyo", "support",
+]);
+const TRANSIENT_NAME_PREFIXES: readonly string[] = [
+  "responder a", "reply to", "reaccionar con", "react with", "reacciono con", "reacted with",
+];
+const GENERIC_CHECKBOX_SLUGS: ReadonlySet<string> = new Set([
+  "checkbox", "casilla-de-seleccion", "seleccionar", "select", "check", "marcar",
+  "casilla-de-verificacion", "activar", "checkbox-1", "checkbox-2",
+]);
+const CONVERSATION_CONTAINER_NAME_PATTERN =
+  /\b(mensajes|mensaje|conversation|conversations|chat|chats|thread|threads|hilo|hilos|direct-messages)\b/i;
+const CONVERSATION_ITEM_MENU_PATTERN =
+  /\b(opciones de mensaje|opciones del mensaje|message options|acciones del mensaje|message actions)\b/i;
+const INLINE_ATTACHMENT_DOWNLOAD_PATTERN =
+  /\b(descargar archivo adjunto|descargar adjunto|download attachment|download file)\b/i;
+const LITERAL_URL_NAME_PATTERN = /^https?:\/\/[^\s]+$/i;
+const OUTBOUND_REDIRECTOR_PATTERN = /\/(?:safety\/go|redir|redirect)\b/i;
+const USER_CONTENT_EXTERNAL_HOSTS =
+  /(?:^|\.)(?:drive\.google\.com|docs\.google\.com|zoom\.us|teams\.microsoft\.com|meet\.google\.com|dropbox\.com|wetransfer\.com)$/i;
+
+// Dynamic list result container indicators (e.g. search hits, job listings, catalog feeds)
+const DYNAMIC_LIST_CONTAINER_NAME_PATTERN =
+  /\b(resultados|results|empleos|jobs|candidatos|candidates|articulos|articles|publicaciones|posts|productos|products|noticias|news)\b/i;
+
+// Item-level transient actions inside dynamic collections
+const ITEM_LEVEL_ACTION_NAME_PATTERN =
+  /^(descartar|dismiss|guardar empleo|save job|descartar empleo|dismiss job|solicitar empleo|mas opciones para el empleo|mas opciones|more options)\b/i;
+
+// Structural filters/query controls that MUST be preserved even inside search/collection regions
+const STRUCTURAL_FILTER_NAME_PATTERN =
+  /^(filtrar por|filter by|fecha de|tipo de|nivel de|en remoto|modalidad|ordenar por|sort by|buscar|search|borrar seleccion|clear filters|limpiar filtros|menos de \d+)\b/i;
+
+/** True when a container represents an informal dynamic conversation/message list. */
+export function isConversationContainer(
+  raw: Pick<RawElement, "containerRole" | "containerName">,
+): boolean {
+  if (raw.containerRole === undefined) {
+    return false;
+  }
+  if (DYNAMIC_CONTAINER_ROLES.has(raw.containerRole)) {
+    return true;
+  }
+  if (
+    (raw.containerRole === "list" || raw.containerRole === "region" || raw.containerRole === "grid" || raw.containerRole === "listbox") &&
+    raw.containerName !== undefined &&
+    CONVERSATION_CONTAINER_NAME_PATTERN.test(raw.containerName)
+  ) {
+    return true;
+  }
+  return false;
+}
+
+/** True when a container represents a dynamic search results list, catalog feed, or entity stream. */
+export function isDynamicResultsContainer(
+  raw: Pick<RawElement, "containerRole" | "containerName">,
+): boolean {
+  if (raw.containerRole === undefined) {
+    return false;
+  }
+  if (DYNAMIC_CONTAINER_ROLES.has(raw.containerRole)) {
+    return true;
+  }
+  if (
+    (raw.containerRole === "list" || raw.containerRole === "region" || raw.containerRole === "grid") &&
+    raw.containerName !== undefined &&
+    DYNAMIC_LIST_CONTAINER_NAME_PATTERN.test(raw.containerName)
+  ) {
+    return true;
+  }
+  return false;
+}
+
+/** Structural controls (query inputs, filter toggles, sorting, pagination) that MUST NOT be pruned. */
+export function isStructuralControl(
+  raw: Pick<RawElement, "role" | "name" | "containerRole">,
+): boolean {
+  if (raw.role === "textbox" || raw.role === "searchbox" || raw.role === "combobox") {
+    return true;
+  }
+  const folded = foldText(raw.name);
+  if (STRUCTURAL_FILTER_NAME_PATTERN.test(folded)) {
+    return true;
+  }
+  if (folded.startsWith("pagina ") || folded.startsWith("page ") || folded === "siguiente" || folded === "anterior" || folded === "next" || folded === "prev") {
+    return true;
+  }
+  return false;
+}
+
+/** True when an action represents an item-level or card-level transient button inside a dynamic collection. */
+export function isDynamicListItemAction(
+  raw: Pick<RawElement, "role" | "name" | "containerRole" | "containerName">,
+): boolean {
+  if (!ACTION_ROLES.has(raw.role)) {
+    return false;
+  }
+  // Structural controls (filters, pagination, inputs) are never pruned
+  if (isStructuralControl(raw)) {
+    return false;
+  }
+
+  const folded = foldText(raw.name);
+  if (ITEM_LEVEL_ACTION_NAME_PATTERN.test(folded)) {
+    return true;
+  }
+
+  if (isDynamicResultsContainer(raw)) {
+    // If it's inside a dynamic results container and is a card-like item (e.g. contains job details or company)
+    // or generic "más opciones", prune it from global screen actions
+    if (folded === "mas opciones" || folded === "more options" || folded === "opciones") {
+      return true;
+    }
+    // Result card title buttons typically contain long composite names or qualifications
+    if (raw.containerRole === "list" && (raw.name.includes(" (") || raw.name.length > 35)) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+/** Anonymous or generic checkboxes/switches inside list/feed/conversation viewports. */
+export function isAnonymousListCheckbox(
+  raw: Pick<RawElement, "role" | "name" | "containerRole">,
+): boolean {
+  if (raw.role !== "checkbox" && raw.role !== "switch") {
+    return false;
+  }
+  const slug = foldText(raw.name).replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
+  if (slug === "") {
+    return true;
+  }
+  if (raw.containerRole !== undefined && GENERIC_CHECKBOX_SLUGS.has(slug)) {
+    return true;
+  }
+  return false;
+}
+
+/** Quick-reaction buttons and emoji affirmations. */
+export function isQuickReactionControl(
+  raw: Pick<RawElement, "role" | "name">,
+): boolean {
+  if (!ACTION_ROLES.has(raw.role) && raw.role !== "checkbox") {
+    return false;
+  }
+  const trimmed = raw.name.trim();
+  if (trimmed === "") {
+    return false;
+  }
+  const slug = foldText(trimmed).replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
+  if (slug === "" && REACTION_EMOJI_PATTERN.test(trimmed)) {
+    return true;
+  }
+  const folded = foldText(trimmed)
+    .replace(/[^\p{L}\p{N}\s]+/gu, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+  if (QUICK_REACTION_PHRASES.has(folded)) {
+    return true;
+  }
+  if (REACTION_EMOJI_PATTERN.test(trimmed)) {
+    const wordCount = folded === "" ? 0 : folded.split(" ").length;
+    if (wordCount <= 6) {
+      return true;
+    }
+  }
+  return false;
+}
+
+/** External links pasted inside user messages/comments or outbound redirectors. */
+export function isUserContentExternalLink(
+  raw: Pick<RawElement, "name" | "href" | "containerRole" | "containerName">,
+  classified: { href: string; external: boolean },
+  pageUrl: string,
+): boolean {
+  if (LITERAL_URL_NAME_PATTERN.test(raw.name.trim())) {
+    return true;
+  }
+  const rawHref = raw.href ?? "";
+  if (OUTBOUND_REDIRECTOR_PATTERN.test(rawHref)) {
+    return true;
+  }
+  if (classified.external) {
+    if (isConversationContainer(raw) || isDynamicResultsContainer(raw)) {
+      return true;
+    }
+    try {
+      const targetHost = new URL(rawHref, pageUrl).hostname;
+      if (USER_CONTENT_EXTERNAL_HOSTS.test(targetHost)) {
+        return true;
+      }
+    } catch {
+      // ignore unparsable URL
+    }
+  }
+  return false;
+}
+
+/** Transient or dynamic content links (e.g. news stories, articles) inside feed/results. */
+export function isDynamicContentLink(
+  raw: Pick<RawElement, "href" | "containerRole" | "containerName">,
+): boolean {
+  const href = raw.href ?? "";
+  if (href.includes("/news/story/") || href.includes("/games/") || href.includes("/company/") && href.includes("/life/")) {
+    return true;
+  }
+  return false;
+}
