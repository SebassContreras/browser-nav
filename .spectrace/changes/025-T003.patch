+function findMatchingScreenIndex(screens: readonly Screen[], learned: Screen): number {
+  const byExactRoute = screens.findIndex((screen) => screen.route === learned.route);
+  if (byExactRoute >= 0) {
+    return byExactRoute;
+  }
+  let bestIndex = -1;
+  let bestScore = -Infinity;
+  screens.forEach((screen, idx) => {
+    try {
+      const m = matchRoute(screen.route, learned.route);
+      if (m !== null) {
+        const score = routeSpecificity(m);
+        if (score > bestScore) {
+          bestScore = score;
+          bestIndex = idx;
+        }
+      }
+    } catch {
+      // ignore invalid route patterns during candidate lookup
+    }
+  });
+  if (bestIndex >= 0) {
+    return bestIndex;
+  }
+  return screens.findIndex((screen) => screen.id === learned.id);
+}
