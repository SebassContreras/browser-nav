new file mode 100644
index 0000000..5722892
--- /dev/null
+++ b/src/browser/auth-watcher.ts
@@ -0,0 +1,111 @@
+import { PwaNavError } from "../core/errors.js";
+import { evaluateSessionHealth, type SessionVerdict } from "./session-health.js";
+import { readProfileCookies, type StoredCookie } from "./session-reader.js";
+
+export interface WatchAuthOptions {
+  profileDir: string;
+  host: string;
+  timeoutMs?: number;
+  pollIntervalMs?: number;
+  authCookieNames?: readonly string[];
+  signal?: AbortSignal;
+}
+
+/**
+ * Service boundary interface for monitoring session health until authenticated.
+ * Follows SRP: only responsible for observing profile authentication status.
+ * Anti-corruption: swappable and testable without touching real files or timers.
+ */
+export interface AuthWatcher {
+  waitForAuth(options: WatchAuthOptions): Promise<{ verdict: SessionVerdict }>;
+}
+
+export interface AuthWatcherDeps {
+  readCookiesFn?: (profileDir: string) => Promise<StoredCookie[] | null>;
+  evaluateHealthFn?: typeof evaluateSessionHealth;
+  sleepFn?: (ms: number, signal?: AbortSignal) => Promise<void>;
+  nowFn?: () => number;
+}
+
+function defaultSleep(ms: number, signal?: AbortSignal): Promise<void> {
+  return new Promise((resolve, reject) => {
+    if (signal?.aborted) {
+      reject(new PwaNavError("timeout", "auth observation aborted"));
+      return;
+    }
+    const timer = setTimeout(() => {
+      signal?.removeEventListener("abort", onAbort);
+      resolve();
+    }, ms);
+
+    function onAbort() {
+      clearTimeout(timer);
+      reject(new PwaNavError("timeout", "auth observation aborted"));
+    }
+
+    signal?.addEventListener("abort", onAbort, { once: true });
+  });
+}
+
+export class DefaultAuthWatcher implements AuthWatcher {
+  private readonly readCookies: (profileDir: string) => Promise<StoredCookie[] | null>;
+  private readonly evaluateHealth: typeof evaluateSessionHealth;
+  private readonly sleep: (ms: number, signal?: AbortSignal) => Promise<void>;
+  private readonly now: () => number;
+
+  constructor(deps: AuthWatcherDeps = {}) {
+    this.readCookies = deps.readCookiesFn ?? readProfileCookies;
+    this.evaluateHealth = deps.evaluateHealthFn ?? evaluateSessionHealth;
+    this.sleep = deps.sleepFn ?? defaultSleep;
+    this.now = deps.nowFn ?? Date.now;
+  }
+
+  async waitForAuth(options: WatchAuthOptions): Promise<{ verdict: SessionVerdict }> {
+    const timeoutMs = options.timeoutMs ?? 180_000;
+    const pollIntervalMs = options.pollIntervalMs ?? 1_000;
+    const startTime = this.now();
+
+    for (;;) {
+      if (options.signal !== undefined && options.signal.aborted) {
+        throw new PwaNavError("timeout", "auth observation aborted by caller");
+      }
+
+      const elapsed = this.now() - startTime;
+      if (elapsed >= timeoutMs) {
+        throw new PwaNavError(
+          "timeout",
+          `timed out waiting for session authentication on ${options.host} after ${String(Math.round(timeoutMs / 1000))}s`,
+        );
+      }
+
+      try {
+        const cookies = await this.readCookies(options.profileDir);
+        const health = this.evaluateHealth(cookies, {
+          host: options.host,
+          nowMs: this.now(),
+          ...(options.authCookieNames ? { authCookieNames: options.authCookieNames } : {}),
+        });
+
+        if (health.verdict === "authenticated") {
+          return { verdict: health.verdict };
+        }
+      } catch (err) {
+        // Tolerant to transient SQLite lock/copy collisions during user sign in
+        if (err instanceof PwaNavError && err.code === "timeout") {
+          throw err;
+        }
+      }
+
+      const remaining = timeoutMs - (this.now() - startTime);
+      const nextSleep = Math.min(pollIntervalMs, Math.max(0, remaining));
+      if (nextSleep <= 0) {
+        throw new PwaNavError(
+          "timeout",
+          `timed out waiting for session authentication on ${options.host} after ${String(Math.round(timeoutMs / 1000))}s`,
+        );
+      }
+
+      await this.sleep(nextSleep, options.signal);
+    }
+  }
+}
diff --git a/src/browser/process-terminator.ts b/src/browser/process-terminator.ts
new file mode 100644
index 0000000..1144238
--- /dev/null
+++ b/src/browser/process-terminator.ts
@@ -0,0 +1,108 @@
+import { PwaNavError } from "../core/errors.js";
+import { inspectProfileLock, type ProfileLockDeps } from "./profile-lock.js";
+
+export interface TerminateOptions {
+  gracePeriodMs?: number;
+  pollIntervalMs?: number;
+  signal?: AbortSignal;
+}
+
+/**
+ * Service boundary interface for gracefully terminating browser processes and verifying lock release.
+ * Follows SRP: only responsible for stopping the process and ensuring the profile directory lock is freed.
+ * Anti-corruption: isolates OS-specific kill commands and inspectProfileLock loops behind an interface.
+ */
+export interface ProcessTerminator {
+  terminate(pid: number, profileDir: string, options?: TerminateOptions): Promise<void>;
+}
+
+export interface ProcessTerminatorDeps {
+  platform?: NodeJS.Platform;
+  killFn?: (pid: number, force: boolean) => Promise<void>;
+  sleepFn?: (ms: number) => Promise<void>;
+  lockDeps?: ProfileLockDeps;
+  nowFn?: () => number;
+}
+
+async function defaultKill(pid: number, force: boolean, platform: NodeJS.Platform): Promise<void> {
+  if (platform === "win32") {
+    const { execFile } = await import("node:child_process");
+    const { promisify } = await import("node:util");
+    const execFileAsync = promisify(execFile);
+    const args = ["/PID", String(pid), "/T"];
+    if (force) {
+      args.push("/F");
+    }
+    try {
+      await execFileAsync("taskkill", args);
+    } catch {
+      // Process may already have terminated cleanly
+    }
+  } else {
+    try {
+      process.kill(pid, force ? "SIGKILL" : "SIGTERM");
+    } catch {
+      // Ignore if ESRCH (already dead)
+    }
+  }
+}
+
+function defaultSleep(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+export class DefaultProcessTerminator implements ProcessTerminator {
+  private readonly platform: NodeJS.Platform;
+  private readonly kill: (pid: number, force: boolean) => Promise<void>;
+  private readonly sleep: (ms: number) => Promise<void>;
+  private readonly lockDeps?: ProfileLockDeps;
+  private readonly now: () => number;
+
+  constructor(deps: ProcessTerminatorDeps = {}) {
+    this.platform = deps.platform ?? process.platform;
+    this.kill = deps.killFn ?? ((pid, force) => defaultKill(pid, force, this.platform));
+    this.sleep = deps.sleepFn ?? defaultSleep;
+    this.lockDeps = deps.lockDeps;
+    this.now = deps.nowFn ?? Date.now;
+  }
+
+  async terminate(pid: number, profileDir: string, options: TerminateOptions = {}): Promise<void> {
+    const gracePeriodMs = options.gracePeriodMs ?? 4_000;
+    const pollIntervalMs = options.pollIntervalMs ?? 250;
+    const startTime = this.now();
+
+    // 1. Request graceful termination first
+    await this.kill(pid, false);
+
+    // 2. Poll until profile lock is verified 'free'
+    let forceKillAttempted = false;
+    for (;;) {
+      if (options.signal !== undefined && options.signal.aborted) {
+        throw new PwaNavError("timeout", "termination aborted by signal");
+      }
+
+      const lock = await inspectProfileLock(profileDir, {
+        platform: this.platform,
+        ...this.lockDeps,
+      });
+
+      if (lock.state === "free") {
+        return;
+      }
+
+      const elapsed = this.now() - startTime;
+      if (elapsed >= gracePeriodMs && !forceKillAttempted) {
+        // Escalate to force kill if grace period exceeded
+        await this.kill(pid, true);
+        forceKillAttempted = true;
+      } else if (elapsed >= gracePeriodMs + 3_000) {
+        throw new PwaNavError(
+          "session_busy",
+          `failed to release profile lock for PID ${String(pid)} after termination timeout`,
+        );
+      }
+
+      await this.sleep(pollIntervalMs);
+    }
+  }
+}
diff --git a/src/browser/test/auth-watcher.test.ts b/src/browser/test/auth-watcher.test.ts
