@@ -0,0 +1,134 @@
+import { PwaNavError } from "./errors.js";
+import { type AppRegistry } from "./app-registry.js";
+
+/**
+ * Standard canonical shortcuts for common web services and apps.
+ */
+export const CANONICAL_ALIASES: Readonly<Record<string, { url: string; slug: string }>> = Object.freeze({
+  notebook: { url: "https://notebooklm.google.com", slug: "notebook" },
+  notebooklm: { url: "https://notebooklm.google.com", slug: "notebooklm" },
+  google: { url: "https://www.google.com", slug: "google" },
+  mercadona: { url: "https://tienda.mercadona.es", slug: "mercadona" },
+  linkedin: { url: "https://www.linkedin.com", slug: "linkedin" },
+  github: { url: "https://github.com", slug: "github" },
+  twitter: { url: "https://x.com", slug: "twitter" },
+  x: { url: "https://x.com", slug: "x" },
+});
+
+export interface NavigationResolution {
+  /** Fully qualified HTTP(S) URL to navigate to */
+  url: string;
+  /** Suggested or resolved app slug for storage/screens partition */
+  appSlug: string;
+}
+
+/**
+ * Validates whether a string has a recognizable domain or hostname pattern with a valid TLD.
+ * Matches: domain.tld, sub.domain.tld, localhost (with optional port and path).
+ * Excludes arbitrary bare words without dots (like "linkeding" or "search query").
+ */
+export function isValidDomainFormat(input: string): boolean {
+  const trimmed = input.trim();
+  if (trimmed.length === 0 || /\s/.test(trimmed)) {
+    return false;
+  }
+  // Allow localhost or localhost:port
+  if (/^localhost(:\d+)?(\/.*)?$/i.test(trimmed)) {
+    return true;
+  }
+  // Standard domain pattern: at least one dot, valid labels, TLD of >= 2 letters, optional port and path
+  const domainPattern = /^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*\.[a-zA-Z]{2,}(:\d+)?(\/.*)?$/;
+  return domainPattern.test(trimmed);
+}
+
+/**
+ * Resolves a raw navigation input (URL, slug, alias, or domain) into a verified navigation target.
+ * Rejects invalid strings, typos, or bare search words fail-fast with `PwaNavError("invalid_args")`.
+ */
+export async function resolveNavigationTarget(
+  rawInput: string,
+  registry?: AppRegistry,
+): Promise<NavigationResolution> {
+  const input = rawInput.trim();
+  if (!input) {
+    throw new PwaNavError("invalid_args", "missing <url>.", {
+      hint: "provide a full http(s) URL (e.g. https://www.linkedin.com), a domain (e.g. linkedin.com), or a registered app slug.",
+    });
+  }
+
+  // 1. Check if already a full HTTP(S) URL
+  try {
+    const parsed = new URL(input);
+    if (parsed.protocol === "http:" || parsed.protocol === "https:") {
+      let appSlug = "";
+      if (registry) {
+        appSlug = await registry.resolveSlug(input);
+      }
+      return { url: input, appSlug };
+    }
+  } catch {
+    // Not a direct standard URL; continue to resolution
+  }
+
+  const lowerInput = input.toLowerCase();
+
+  // 2. Check dynamic registry for registered app definitions
+  if (registry) {
+    try {
+      const config = await registry.load();
+      if (config.apps && config.apps[lowerInput]) {
+        const appDef = config.apps[lowerInput];
+        if (appDef && Array.isArray(appDef.origins) && appDef.origins.length > 0) {
+          const origin = appDef.origins[0];
+          if (origin) {
+            return {
+              url: origin,
+              appSlug: lowerInput,
+            };
+          }
+        }
+      }
+    } catch {
+      // In case registry reading fails or is empty, fallback to next checks
+    }
+  }
+
+  // 3. Check known canonical web service aliases
+  const alias = CANONICAL_ALIASES[lowerInput];
+  if (alias) {
+    return {
+      url: alias.url,
+      appSlug: alias.slug,
+    };
+  }
+
+  // 4. Check domain name auto-completion (e.g. "linkedin.com" -> "https://linkedin.com")
+  if (isValidDomainFormat(input)) {
+    const fullUrl = `https://${input}`;
+    try {
+      const parsed = new URL(fullUrl);
+      if (parsed.protocol === "https:" && parsed.hostname) {
+        let appSlug = "";
+        if (registry) {
+          appSlug = await registry.resolveSlug(fullUrl);
+        }
+        return {
+          url: fullUrl,
+          appSlug,
+        };
+      }
+    } catch {
+      // Fall through to error
+    }
+  }
+
+  // 5. Fail-fast: input is neither a valid URL, registered slug, alias, nor valid domain
+  throw new PwaNavError(
+    "invalid_args",
+    `cannot resolve navigation target "${input}": not a valid URL, domain, or registered app slug.`,
+    {
+      hint: `Did you mean a full URL like "https://${input}.com", or to search in the active page? ` +
+        `pwa-nav open only accepts full URLs, valid domains, or app slugs. Use pwa_fill or pwa_click to interact in-page.`,
+    },
+  );
+}
