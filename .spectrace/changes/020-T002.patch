+  it("resolves workspace agent dir cleanly with resolveWorkspaceAgentDir", () => {
+    assert.equal(resolveWorkspaceAgentDir("/my/project"), resolve("/my/project", ".agent"));
+  });
+
+  it("resolves agentDir from explicit workspaceDir", () => {
