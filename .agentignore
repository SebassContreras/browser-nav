# .agentignore
# Patterns and files excluded from AI agent context indexing and scanning

# Secrets and environment configurations
.env
.env*
!.env.example
*.pem
*.key
*.cert
*.pfx
*credentials*
*secret*

# Dependencies
node_modules/
.pnpm-store/

# Build artifacts and compilation caches
dist/
*.tsbuildinfo

# Runtime state (browser profiles, screen maps, snapshots, evidence)
.agent/
test-cache/

# Test and coverage artifacts
coverage/

# Logs and local state
*.log
logs/
*.sqlite
*.db

# Operating system and editor temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/
